DB_HOST=localhost
DB_PORT=5432
DB_NAME=mufsal
DB_USER=postgres
DB_PASSWORD=your_postgres_password
SESSION_SECRET=mufsal-secret-123456789
DEV_LOGIN=1
# DEV_LOGIN=1 also shows the password-reset link on the page. Use 0 on Render.

# E-mail for the password-reset link (leave SMTP_HOST empty to send nothing).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, and an App password as SMTP_PASSWORD.
APP_URL=http://127.0.0.1:8000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# SMTP_SECURITY=starttls   # starttls (default), ssl (port 465) or none
# HTTPS_ONLY=1   # add this line on Render (secure cookie)
