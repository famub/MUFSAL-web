<!doctype html>
<html lang="en" dir="ltr">
<!-- lang="{{ lang }}" dir="{{ direction }} -->

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>MUFSAL - Case review</title>

  <link rel="stylesheet" href="static/css/global.css" />
  <link rel="stylesheet" href="static/css/header.css" />
  <link rel="stylesheet" href="static/css/review.css" />
</head>

<body data-page="detail">
  <header>
    <div class="header-inner">
      <div id="header-logo-">
        <a href="dashboard.html" aria-label="MUFSAL home">
          <img src="assets/logo-light.png" alt="MUFSAL" class="logo-img" />
        </a>
      </div>

      <div class="header-actions">
        <button type="button" id="lang-toggle">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
          </svg>
          ع
        </button>

        <a href="profile.html" class="profile-link">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2"
            stroke="currentColor" class="size-6">
            <path stroke-linecap="round" stroke-linejoin="round"
              d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
          </svg>
        </a>

        <span class="site-header__rule" aria-hidden="true"></span>

        <a href="logout.html" class="logout-link">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"
            stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round"
              d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
          </svg>
        </a>
      </div>
    </div>
  </header>

  <main class="review-main">
    <a class="back-link" href="review-cases.html"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg><span data-i18n="back">Back to cases</span></a>

    <div class="page-head case-title">
      <div>
        <h1 id="case-title">Case</h1>
        <p id="case-name"></p>
      </div>
      <div class="meta">
        <span id="case-prio"></span>
        <span id="status-badge" class="badge badge-pending"></span>
      </div>
    </div>

    <div class="grid-2">
      <!-- LEFT: X-ray + heatmap -->
      <section class="card" aria-labelledby="h-xray">
        <h2 id="h-xray"><span class="icon-box"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 7a2 2 0 012-2h14a2 2 0 012 2v10a2 2 0 01-2 2H5a2 2 0 01-2-2V7zm6 3a2 2 0 100 4 2 2 0 000-4z"/></svg></span><span data-i18n="xray">X-ray image</span></h2>
        <div id="xray-box" class="xray-box">
          <!-- TODO(backend): set src of both images (XrayImage.filePath and PredictionResult.heatmapPath) -->
          <img id="xray-img" alt="Knee X-ray" hidden />
          <img id="heat-img" class="heat" alt="AI heatmap" hidden />
          <div class="xray-placeholder" data-i18n="noImage">X-ray image will appear here</div>
        </div>
        <div class="viewer-controls">
          <label class="switch"><input type="checkbox" id="heat-toggle" /><span data-i18n="showHeat">Show heatmap</span></label>
        </div>
        <p class="hint" data-i18n="heatHint"></p>
      </section>

      <!-- RIGHT: AI result -->
      <section class="card" aria-labelledby="h-ai">
        <h2 id="h-ai"><span class="icon-box"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2 2 0 01-.586 1.414L4 15.5V19a2 2 0 002 2h12a2 2 0 002-2v-3.5l-5.164-5.268a2 2 0 01-.586-1.414V3.104M8 3h8"/></svg></span><span data-i18n="aiResult">AI result</span></h2>
        <div class="grade-row">
          <div id="grade-circle" class="grade-circle"><small data-i18n="klGrade">KL grade</small><strong id="grade-num">0</strong></div>
          <div>
            <p id="grade-name" class="grade-name"></p>
            <p id="grade-desc" class="grade-desc"></p>
          </div>
        </div>
        <p id="edited-note" class="edited-note hidden"></p>

        <dl class="kv-list">
          <div class="kv"><dt data-i18n="confidence">Confidence score</dt><dd id="conf"></dd></div>
        </dl>
        <h3 class="hint" data-i18n="probs" style="margin-top:16px"></h3>
        <ul id="probs" class="prob-list"></ul>

        <div style="margin-top:16px">
          <button id="edit-btn" type="button" class="btn btn-outline" data-i18n="editAi">Edit AI result</button>
        </div>
        <div id="edit-box" class="edit-box hidden">
          <label for="grade-input" data-i18n="newGrade">New KL grade (0 to 4)</label>
          <input id="grade-input" class="field small" type="text" inputmode="numeric" maxlength="3" autocomplete="off" />
          <div id="grade-err" class="error-msg hidden" role="alert"></div>
          <div class="edit-actions">
            <button id="save-grade" type="button" class="btn btn-primary" data-i18n="save">Save</button>
            <button id="cancel-grade" type="button" class="btn btn-ghost" data-i18n="cancel">Cancel</button>
          </div>
        </div>
      </section>

      <!-- Case info -->
      <section class="card" aria-labelledby="h-info">
        <h2 id="h-info"><span class="icon-box"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg></span><span data-i18n="caseInfo">Case information</span></h2>
        <dl id="info" class="kv-list"></dl>
      </section>

      <!-- Medical history -->
      <section class="card" aria-labelledby="h-history">
        <h2 id="h-history"><span class="icon-box"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg></span><span data-i18n="history">Medical history</span></h2>
        <div id="history"></div>
      </section>
    </div>

    <!-- Doctor decision -->
    <section class="card decision" aria-labelledby="h-decision">
      <h2 id="h-decision"><span class="icon-box"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg></span><span data-i18n="decision">Doctor decision</span></h2>
      <div id="success-banner" class="success-banner hidden" role="status"></div>
      <label for="notes" style="display:block;font-weight:500;margin-bottom:6px" data-i18n="notes">Clinical notes</label>
      <textarea id="notes" class="field" data-i18n-ph="notesPh" placeholder="Write your clinical notes about this case..."></textarea>
      <p class="hint" data-i18n="notesHint"></p>
      <div id="notes-err" class="error-msg hidden" role="alert"></div>
      <div class="decision-foot">
        <div>
          <span class="muted" data-i18n="finalGrade">Final KL grade</span>:
          <strong id="final-grade"></strong>
          <div id="pending-note" class="hint" data-i18n="pendingNote"></div>
        </div>
        <button id="confirm-btn" type="button" class="btn btn-primary" data-i18n="confirm">Confirm result</button>
      </div>
    </section>

    <p class="disclaimer" data-i18n="disclaimer"></p>
  </main>

  <!-- TODO: paste the team's shared footer here (the footer was not included in what I received) -->

  <script src="static/js/review.js"></script>
</body>

</html>
